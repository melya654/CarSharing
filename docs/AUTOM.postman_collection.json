        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Андрій\",\n  \"email\": \"andrii@gmail.com\",\n  \"phone\": \"+380501234567\",\n  \"message\": \"Хочу на вихідні\",\n  \"carId\": 1\n}"
