        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cars",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cars"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Renault Megane\",\n  \"brand\": \"Renault\",\n  \"year\": 2017,\n  \"pricePerDay\": 950,\n  \"available\": 2\n}"
        }
      }
    },
    {
      "name": "Додати авто з помилками (400)",
