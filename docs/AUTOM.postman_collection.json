{
  "info": {
    "name": "AUTOM API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Список авtо",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cars",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cars"
          ]
        }
      }
    },
    {
      "name": "Одне авто",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cars/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cars",
            "1"
          ]
        }
      }
    },
    {
      "name": "Неіснуюче авто (404)",
