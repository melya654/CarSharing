          "mode": "raw",
          "raw": "{\n  \"title\": \"A\"\n}"
        }
      }
    },
    {
      "name": "Змінити ціну",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cars/9",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cars",
            "9"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pricePerDay\": 1000\n}"
        }
      }
    },
